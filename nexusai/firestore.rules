rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All data access goes through the backend (Admin SDK bypasses rules).
    // Clients may only read their own data; they can never write directly.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
